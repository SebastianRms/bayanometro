# =================================================================
# BAYANÓMETRO — Variables de Entorno de Configuración
# Copia este archivo como '.env' en la raíz y rellena tus claves reales:
#   cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. Base de Datos PostgreSQL
# -----------------------------------------------------------------
DB_NAME=bayanometro_db
DB_USER=postgres
DB_PASS=postgres_password_123
DB_PORT=5432

# Puerto del servicio HTTP de Bayanómetro
PORT=8080

# -----------------------------------------------------------------
# 2. Perfil de Inteligencia Artificial
# Opciones disponibles: 'gemini' o 'deepseek'
# -----------------------------------------------------------------
QUARKUS_PROFILE=gemini

# Si usas perfil 'gemini':
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Si usas perfil 'deepseek':
LLM_API_KEY=tu_deepseek_api_key_aqui
LLM_BASE_URL=https://api.deepseek.com/v1

# -----------------------------------------------------------------
# 3. Integración con Telegram Bot
# -----------------------------------------------------------------
# Token entregado por @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Token secreto arbitrario para validar que las peticiones vengan de Telegram
# (Header: X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=mi_token_secreto_super_seguro_123456

# Lista de IDs numéricos de Telegram autorizados (tu ID y el de tu hermano) separados por coma
# Puedes obtener tu ID enviando un mensaje a @userinfobot en Telegram
TELEGRAM_ALLOWED_USERS=4493833071,987654321

# -----------------------------------------------------------------
# 4. API-Sports (Fútbol, Básquetbol, Béisbol, NFL)
# -----------------------------------------------------------------
# Clave unificada del dashboard de API-Sports (100 peticiones/día)
API_SPORTS_KEY=tu_api_sports_key_aqui
